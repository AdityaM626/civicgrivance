						"body": {
							"mode": "raw",
							"raw": "{\n  \"notes\": \"Pothole repaired with asphalt, levelled, and safety barriers removed.\",\n  \"photoUrls\": [\n    \"https://example.com/proof1.jpg\",\n    \"https://example.com/proof2.jpg\"\n  ]\n}"
